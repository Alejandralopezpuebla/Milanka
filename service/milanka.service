[Unit]
Description=Milanka PIR-driven screen control
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/Milanka
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
# Force pygame through Xwayland (X11) rather than native Wayland. This lets
# pygame's own mouse.set_visible(False) / set_pos(...) actually take effect —
# labwc honors cursor requests from Xwayland clients. Native Wayland on labwc
# ignored them, leaving the cursor visible.
Environment=SDL_VIDEODRIVER=x11
# Route audio through PulseAudio/PipeWire — the same server VLC and the desktop
# use — so pygame honors your chosen default output (e.g. the 3.5mm jack).
# Without this, SDL defaults to the raw ALSA driver, which bypasses that
# routing and plays to the wrong device (often HDMI): the soundtrack shows as
# `audio: looping soundtrack` in the logs yet is silent on the jack.
Environment=SDL_AUDIODRIVER=pulseaudio
# Wait a few seconds for the desktop/Wayland compositor to be fully up before
# pygame tries to grab the screen. Without this the service races labwc and
# fails on the first attempt(s), then gets restart-looped.
ExecStartPre=/bin/sleep 5
ExecStart=/opt/Milanka/venv/bin/python /opt/Milanka/src/main.py
# Restart=always so the auto-updater can sys.exit(0) and have systemd bring
# us back with the new code. systemctl stop/restart are still respected
# (systemd-initiated stops don't trigger Restart=).
Restart=always
RestartSec=3

# Bound how long `systemctl stop` waits. If the parent is mid-subprocess.run
# (e.g. inside the auto-updater's git fetch or install.sh), it can't process
# SIGTERM until that returns. After 10s systemd sends SIGKILL and we move on.
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=default.target
